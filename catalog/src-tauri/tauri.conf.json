{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "intelligence-catalog",
    "version": "1.0.0",
    "identifier": "com.olhodedeus.intelligence-catalog",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "title": "Intelligence Catalog — Olho de Deus",
                "width": 1440,
                "height": 900,
                "minWidth": 1024,
                "minHeight": 600,
                "resizable": true,
                "fullscreen": false,
                "decorations": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' data: blob: http://localhost:8001; media-src 'self' blob: http://localhost:8001 http://localhost:1984; connect-src 'self' http://localhost:8001 http://localhost:8000 http://localhost:5000; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}